+TEST_CASE("Graph occluded reverse-link retention", "[lite-graph][occluded-link]") {
+    auto graph = vsag::lite::detail::restore_graph_backend(
+        1, 2, 128, {0, 1, 2, 3}, {0.F, 0.1F, -1.F, 1.F}, {{1, 2}, {0, 3}, {0, 3}, {1, 2}});
+    REQUIRE(graph);
+    const float vector = 0.2F;
+    REQUIRE((*graph)->Add(4, &vector, 1));
+    REQUIRE((*graph)->Size() == 5);
+    require_incoming_matches(**graph);
+#if defined(VSAG_LITE_EXPERIMENT_OCCLUDED_LINK)
+    REQUIRE((*graph)->LinkAt(0, 0) == 1);
+    REQUIRE((*graph)->LinkAt(0, 1) == 2);
+#else
+    REQUIRE((*graph)->LinkAt(0, 0) == 1);
+    REQUIRE((*graph)->LinkAt(0, 1) == 4);
+#endif
+    // Rejection must not isolate the new node or exceed the existing degree bound.
+    for (uint64_t slot = 0; slot < (*graph)->Size(); ++slot) {
+        REQUIRE((*graph)->IncomingLinkCountAt(slot) > 0);
+        REQUIRE((*graph)->LinkCountAt(slot) <= 2);
+    }
+    const auto found = (*graph)->Search(&vector, 1, 5);
+    REQUIRE(found);
+    REQUIRE(found->size() == 5);
+    REQUIRE(found->front().id == 4);
+    REQUIRE(found->front().distance == 0.F);
+}
