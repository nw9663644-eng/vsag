[
  {
    "name": "format",
    "command": [
      "clang-format-15",
      "--dry-run",
      "--Werror",
      "src/lite/graph_backend.cpp",
      "src/lite/graph_backend_test.cpp"
    ],
    "exit": 0
  },
  {
    "name": "tidy",
    "command": [
      "clang-tidy-15",
      "-p",
      "build-lite-two-incoming-release",
      "src/lite/graph_backend.cpp",
      "src/lite/graph_backend_test.cpp"
    ],
    "exit": 0
  }
]
