+TEST_CASE("Graph reverse-link incoming retention preference", "[lite-graph][incoming-retention]") {
+    const std::vector<int64_t> ids{0, 1, 2, 3};
+    const std::vector<std::vector<uint64_t>> links{{1, 2}, {0, 3}, {0, 3}, {1, 2}};
+    auto graph =
+        vsag::lite::detail::restore_graph_backend(1, 2, 128, ids, {0.0F, 1.0F, 2.0F, -0.2F}, links);
+    REQUIRE(graph);
+    require_incoming_matches(**graph);
+    const float added = 0.1F;
+    REQUIRE((*graph)->Add(4, &added, 1));
+    REQUIRE((*graph)->Size() == 5);
+#if defined(VSAG_LITE_EXPERIMENT_TWO_INCOMING)
+    REQUIRE((*graph)->IncomingLinkCountAt(1) == 2);
+#else
+    REQUIRE((*graph)->IncomingLinkCountAt(1) == 1);
+#endif
+    // The first saturated reverse link still needs the existing fallback. This
+    // experiment does not promise two incoming edges for every node.
+    REQUIRE((*graph)->IncomingLinkCountAt(2) == 1);
+    require_incoming_matches(**graph);
+    for (uint64_t slot = 0; slot < (*graph)->Size(); ++slot) {
+        REQUIRE((*graph)->LinkCountAt(slot) <= 2);
+        REQUIRE((*graph)->IncomingLinkCountAt(slot) > 0);
+    }
+    const auto found = (*graph)->Search(&added, 1, 5);
+    REQUIRE(found);
+    REQUIRE(found->size() == 5);
+    REQUIRE(found->front().id == 4);
+    REQUIRE(found->front().distance == 0.0F);
+}
