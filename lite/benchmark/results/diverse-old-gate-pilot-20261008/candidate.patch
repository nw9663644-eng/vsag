+            if (not fp16_ and not neighbors->empty()) {
+                // Keep only old candidates that are competitive in the new geometry and
+                // are not occluded by a closer current candidate (Full heuristic, alpha 1).
+                std::array<Candidate, K_MAX_DEGREE * 2> ranked{};
+                uint64_t ranked_size = 0;
+                float cutoff = 0.0F;
+                for (const uint64_t candidate : *neighbors) {
